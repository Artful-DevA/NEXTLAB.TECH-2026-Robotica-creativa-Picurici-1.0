static_assert(PIN_ENC_SW  >= 2 && PIN_ENC_SW  <= 7, "Encoder pins must be D2..D7");
static_assert(PIN_ENC_CLK != PIN_ENC_DT && PIN_ENC_CLK != PIN_ENC_SW && PIN_ENC_DT != PIN_ENC_SW,
              "Encoder pins must be different");


